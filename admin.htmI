<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>CamInvest Admin - Sean Morgan</title>
<script src="https://cdn.tailwindcss.com"></script>
</head><body style="background:#f5f7fb;padding:16px">
<h1 style="font-weight:bold;font-size:20px">Admin - CamInvest Hub</h1>
<p>Sean Morgan - Withdraw Requests</p>
<div id="list" style="margin-top:16px"></div>
<button onclick="clearW()" style="background:red;color:white;padding:10px;border-radius:10px;margin-top:16px;width:100%">Clear All</button>
<script>
function load(){
let w=JSON.parse(localStorage.getItem('withdraws')||'[]');
let html='';
if(w.length==0)html='<p style="text-align:center;color:gray;margin-top:40px">No withdraw requests yet.<br>Users request on main site will appear here.</p>';
w.forEach((req,i)=>{
html+=`<div style="background:white;padding:12px;border-radius:12px;margin-bottom:10px">
<b>${req.type}</b> - ${req.num}<br>
Amount: <b>${req.amt} XAF</b> - ${req.date}<br>
<button onclick="pay(${i})" style="background:green;color:white;padding:8px 16px;border-radius:8px;margin-top:8px">✅ Mark Paid & WhatsApp</button>
</div>`;
});
document.getElementById('list').innerHTML=html;
}
function pay(i){
let w=JSON.parse(localStorage.getItem('withdraws')||'[]');
let req=w[i];
if(confirm('You sent '+req.amt+'F to '+req.num+'?')){
w.splice(i,1);
localStorage.setItem('withdraws',JSON.stringify(w));
window.location.href='https://wa.me/'+req.num+'?text=Your '+req.amt+'F withdrawal paid! Thanks for using CamInvest Hub - Sean Morgan';
setTimeout(load,1000);
}
}
function clearW(){if(confirm('Clear all?')){localStorage.removeItem('withdraws');load();}}
load();
</script></body></html>
